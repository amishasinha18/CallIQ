# Base URL of the CallIQ API server.
#
# No fallback is applied in code — lib/apiClient.js and the recording components
# read process.env.NEXT_PUBLIC_API_URL directly, so leaving this unset means every
# request goes to "undefined/..." and fails at runtime rather than at build time.
#
# Local:      the server's PORT from server/.env.example (4100 by default)
# Deployed:   render.yaml already wires this to the API service's URL, alongside
#             CORS_ORIGIN pointing back at this app
#
# NEXT_PUBLIC_ is required: Next.js only exposes variables with that prefix to
# browser code, and all four consumers of this value run in the browser.
NEXT_PUBLIC_API_URL=http://localhost:4100
